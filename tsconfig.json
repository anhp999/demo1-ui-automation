{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"], 
      "@pages/*": ["src/pages/*"] 
    },
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}